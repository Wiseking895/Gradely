# Copy this file to `.env` and fill in your own values.
# Placeholders only — never put real credentials in this file.

# --- Core ---------------------------------------------------------------
# Node environment: development | test | production
NODE_ENV=development

# Port used by the local dev server (npm run dev). Not used on Vercel.
PORT=4000

# Comma-separated list of browser origins allowed by CORS.
# Production must list the real deployed frontend origin(s),
# e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Database (Neon PostgreSQL) ------------------------------------------
# DATABASE_URL: Neon POOLED connection string (host contains "-pooler").
# Used by the application's pg pool at runtime (src/lib/db.ts).
# Neon requires TLS: keep sslmode=require in the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/gradely?sslmode=require&channel_binding=require"

# DIRECT_URL: Neon DIRECT connection string (host without "-pooler").
# Used only by migrations (npm run db:migrate) — Neon recommends running
# schema changes over the direct endpoint. Falls back to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/gradely?sslmode=require&channel_binding=require"

# --- Email verification --------------------------------------------------
# Verification transport (src/services/email.ts):
#   log         development: print the message to the server console
#   memory      tests: in-memory outbox, nothing is sent
#   unavailable production default: delivery fails loudly (no vendor yet)
# Leave unset to use the environment-appropriate default. No raw verification
# token is ever written to production logs.
EMAIL_TRANSPORT=log

# --- Scratch database (local tests/migrations only) -----------------------
# Never put TEST_DATABASE_URL in backend/.env. Select a separate scratch-only
# file explicitly with GRADELY_ENV_FILE. The URL must use 127.0.0.1 (or ::1)
# and an exact scratch database name such as gradely_scratch.
# GRADELY_ENV=scratch
# GRADELY_ENV_FILE=C:\Users\you\AppData\Roaming\Gradely\scratch.env
# SCRATCH_DATABASE_URL="postgresql://gradely_scratch_app:CHANGE_ME@127.0.0.1:5432/gradely_scratch"
# MIGRATION_DATABASE_URL="postgresql://gradely_scratch_app:CHANGE_ME@127.0.0.1:5432/gradely_scratch"
# TEST_DATABASE_URL="postgresql://gradely_scratch_app:CHANGE_ME@127.0.0.1:5432/gradely_scratch"
#
# Database integration tests fail closed when TEST_DATABASE_URL is missing or
# unsafe. They drop and recreate the public schema, so only use a disposable
# database owned by a non-superuser role.

# --- Cloudflare R2 (S3-compatible object storage) -----------------------
# Optional at startup: the API and /api/health work without these.
# Create an R2 API token with Object Read & Write on one bucket only.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=gradely-files
# Optional: base URL if a public bucket/custom domain is ever used for
# non-private assets (logos). Private files (PDFs, photos) use presigned URLs.
R2_PUBLIC_BASE_URL=
