# Copy this file to `.env` and fill in your own values.
# Placeholders only — never put real credentials in this file.

# --- Core ---------------------------------------------------------------
# Node environment: development | test | production
NODE_ENV=development

# Port used by the local dev server (npm run dev). Not used on Vercel.
PORT=4000

# Comma-separated list of browser origins allowed by CORS.
# Production must list the real deployed frontend origin(s),
# e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL via Prisma) -----------------------------------
# DATABASE_URL: pooled runtime connection used by the Prisma Client
# (e.g. Neon/Supabase pooler or PgBouncer transaction pooling).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gradely?sslmode=require"

# DIRECT_URL: unpooled connection used by Prisma CLI (migrate/db push/db pull).
# Migrations cannot run through a pooled connection. Falls back to
# DATABASE_URL when unset (fine for simple local databases).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/gradely?sslmode=require"

# --- Cloudflare R2 (S3-compatible object storage) -----------------------
# Optional at startup: the API and /api/health work without these.
# Create an R2 API token with Object Read & Write on one bucket only.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=gradely-files
# Optional: base URL if a public bucket/custom domain is ever used for
# non-private assets (logos). Private files (PDFs, photos) use presigned URLs.
R2_PUBLIC_BASE_URL=
