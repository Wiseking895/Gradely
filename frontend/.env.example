# Copy this file to `.env` for local development.
# On Vercel, set these in the frontend project's Environment Variables.
#
# NOTE: only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put database, R2, or other secret credentials in frontend env vars.

# Base URL of the Gradely API (backend Vercel project).
# - Leave EMPTY for local development: the Vite dev server proxies /api
#   to http://localhost:4000 (see vite.config.ts).
# - In production set it to the deployed backend URL, e.g.:
#     VITE_API_URL=https://gradely-backend.vercel.app
VITE_API_URL=
